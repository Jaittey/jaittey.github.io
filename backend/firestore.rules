rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function email() {
      return request.auth.token.email;
    }

    function isOwner() {
      return signedIn() && email() == "jaeitte@gmail.com";
    }

    function accessPath() {
      return /databases/$(database)/documents/userAccess/$(email());
    }

    function hasAccess() {
      return signedIn()
        && (isOwner()
          || (exists(accessPath()) && get(accessPath()).data.active == true));
    }

    function role() {
      return isOwner() ? "administrator" : get(accessPath()).data.role;
    }

    function roleIn(roles) {
      return hasAccess() && (isOwner() || role() in roles);
    }

    function salesRole() {
      return roleIn(["manager", "accountant", "staff"]);
    }

    function financeRole() {
      return roleIn(["manager", "accountant"]);
    }

    function hrRole() {
      return roleIn(["hr"]);
    }

    function managementRole() {
      return roleIn(["manager"]);
    }

    match /userAccess/{emailId} {
      allow read: if isOwner() || (signedIn() && emailId == email());
      allow create, update, delete: if isOwner();
    }

    match /customers/{id} {
      allow read: if roleIn(["manager", "accountant", "staff"]);
      allow write: if salesRole();
    }

    match /products/{id} {
      allow read: if hasAccess();
      allow write: if roleIn(["manager", "accountant"]);
    }

    match /invoices/{id} {
      allow read, write: if financeRole();
      allow create: if salesRole();
    }

    match /quotes/{id} {
      allow read: if roleIn(["manager", "accountant", "staff"]);
      allow create, update: if salesRole();
      allow delete: if financeRole();
    }

    match /payments/{id} {
      allow read, write: if financeRole();
    }

    match /expenses/{id} {
      allow read, write: if financeRole();
    }

    match /billingContracts/{id} {
      allow read, write: if financeRole();
      match /generatedPeriods/{periodId} {
        allow read, write: if financeRole();
      }
    }

    match /employees/{id} {
      allow read, write: if roleIn(["manager", "hr"]);
    }

    match /payroll/{id} {
      allow read, write: if roleIn(["accountant", "hr"]);
    }

    match /budgets/{id} {
      allow read, write: if financeRole();
    }

    match /settings/{id} {
      allow read: if hasAccess();
      allow write: if isOwner();
    }

    match /activityLogs/{id} {
      allow create: if hasAccess();
      allow read, delete: if isOwner();
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
