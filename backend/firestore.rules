rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function email() {
      return request.auth.token.email;
    }

    function isOwner() {
      return signedIn() && email() == "jaeitte@gmail.com";
    }

    function accessPath() {
      return /databases/$(database)/documents/userAccess/$(email());
    }

    function hasAccess() {
      return signedIn()
        && (isOwner()
          || (exists(accessPath()) && get(accessPath()).data.active == true));
    }

    function storedRole() {
      return get(accessPath()).data.role;
    }

    function role() {
      return isOwner()
        ? "administrator"
        : (storedRole() == "manager" ? "manager" : "user");
    }

    function isManager() {
      return hasAccess() && (isOwner() || role() == "manager");
    }

    function isUser() {
      return hasAccess() && role() == "user";
    }

    function isDelegatedManager() {
      return hasAccess() && !isOwner() && role() == "manager";
    }

    function operationalAccess() {
      return isManager() || isUser();
    }

    function payrollPeriodPath(month) {
      return /databases/$(database)/documents/payrollPeriods/$(month);
    }

    function payrollPeriodOpen(month) {
      return !exists(payrollPeriodPath(month))
        || get(payrollPeriodPath(month)).data.status == "OPEN";
    }

    function payrollAdministrativeChange() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status",
        "paymentDate",
        "paymentStatus",
        "paymentMethod",
        "paymentReference",
        "paymentNotes",
        "paidAt",
        "paidBy",
        "approvedAt",
        "approvedBy",
        "reopenedAt",
        "reopenedBy",
        "driveFileId",
        "driveWebViewLink",
        "driveUpdatedAt",
        "cancelledReason",
        "finalSettlementId",
        "updatedAt"
      ]);
    }

    match /userAccess/{emailId} {
      allow read: if isOwner() || (signedIn() && emailId == email());
      allow create, update, delete: if isOwner();
    }

    // Manager and User operational modules.
    match /customers/{id} {
      allow read, write: if operationalAccess();
    }

    match /products/{id} {
      allow read, write: if operationalAccess();
    }

    match /invoices/{id} {
      allow read, write: if operationalAccess();
    }

    match /quotes/{id} {
      allow read, write: if operationalAccess();
    }

    // Employee profiles are visible to both roles, but only Managers may change payroll settings.
    match /employees/{id} {
      allow read: if operationalAccess();
      allow create, update, delete: if isManager();
    }

    // Daily attendance may be entered by Manager or User only while the payroll month is open.
    match /attendance/{id} {
      allow read: if operationalAccess();
      allow create: if operationalAccess()
        && request.resource.data.attendanceMonth is string
        && payrollPeriodOpen(request.resource.data.attendanceMonth);
      allow update: if operationalAccess()
        && resource.data.attendanceMonth is string
        && request.resource.data.attendanceMonth == resource.data.attendanceMonth
        && payrollPeriodOpen(resource.data.attendanceMonth);
      allow delete: if isManager()
        && resource.data.attendanceMonth is string
        && payrollPeriodOpen(resource.data.attendanceMonth);
    }

    // Users can review and print salary information. Managers perform all payroll changes.
    match /payroll/{id} {
      allow read: if operationalAccess();
      allow create: if isManager()
        && (request.resource.data.recordType == "FINAL_SETTLEMENT"
          || (request.resource.data.salaryMonth is string
            && payrollPeriodOpen(request.resource.data.salaryMonth)));
      allow update: if isManager()
        && ((resource.data.salaryMonth is string && payrollPeriodOpen(resource.data.salaryMonth))
          || payrollAdministrativeChange());
      allow delete: if isManager()
        && resource.data.salaryMonth is string
        && payrollPeriodOpen(resource.data.salaryMonth);
    }

    match /salarySlips/{id} {
      allow read: if operationalAccess();
      allow create: if isManager();
      // A Manager can edit or lock an unlocked slip, but cannot edit or unlock it after locking.
      // The Administrator bypasses this restriction through the owner rule below.
      allow update, delete: if isDelegatedManager()
        && (!("locked" in resource.data) || resource.data.locked != true);
    }

    match /attendanceDocuments/{id} {
      allow read, create, update: if operationalAccess();
      allow delete: if isManager();
    }

    match /payrollPeriods/{month} {
      allow read: if operationalAccess();
      allow create, update, delete: if isManager();
    }

    match /finalSettlements/{id} {
      allow read: if operationalAccess();
      allow create, update, delete: if isManager();
    }

    // Manager-only finance and administration modules.
    match /payments/{id} {
      allow read, write: if isManager();
    }

    match /expenses/{id} {
      allow read, write: if isManager();
    }

    match /billingContracts/{id} {
      allow read, write: if isManager();
      match /generatedPeriods/{periodId} {
        allow read, write: if isManager();
      }
    }

    match /budgets/{id} {
      allow read, write: if isManager();
    }

    match /settings/{id} {
      allow read: if hasAccess();
      allow write: if isOwner();
    }

    match /companyAssets/{id} {
      allow read: if hasAccess();
      allow create, update, delete: if isOwner();
    }

    match /activityLogs/{id} {
      allow create: if hasAccess();
      allow read, delete: if isOwner();
      allow update: if false;
    }

    // The fixed Administrator account has complete access, including locked and closed records.
    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
