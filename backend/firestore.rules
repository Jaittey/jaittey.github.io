rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function email() {
      return request.auth.token.email;
    }

    function isOwner() {
      return signedIn() && email() == "jaeitte@gmail.com";
    }

    function accessPath() {
      return /databases/$(database)/documents/userAccess/$(email());
    }

    function hasAccess() {
      return signedIn()
        && (isOwner()
          || (exists(accessPath()) && get(accessPath()).data.active == true));
    }

    function storedRole() {
      return get(accessPath()).data.role;
    }

    function role() {
      return isOwner()
        ? "administrator"
        : (storedRole() == "manager" ? "manager" : "user");
    }

    function isManager() {
      return hasAccess() && (isOwner() || role() == "manager");
    }

    function isUser() {
      return hasAccess() && role() == "user";
    }

    function salesAccess() {
      return isManager() || isUser();
    }

    match /userAccess/{emailId} {
      allow read: if isOwner() || (signedIn() && emailId == email());
      allow create, update, delete: if isOwner();
    }

    // Manager and User: Quotations, Invoices, Customers and Inventory.
    match /customers/{id} {
      allow read, write: if salesAccess();
    }

    match /products/{id} {
      allow read, write: if salesAccess();
    }

    match /invoices/{id} {
      allow read, write: if salesAccess();
    }

    match /quotes/{id} {
      allow read, write: if salesAccess();
    }

    // Manager-only operational departments.
    match /payments/{id} {
      allow read, write: if isManager();
    }

    match /expenses/{id} {
      allow read, write: if isManager();
    }

    match /billingContracts/{id} {
      allow read, write: if isManager();
      match /generatedPeriods/{periodId} {
        allow read, write: if isManager();
      }
    }

    match /employees/{id} {
      allow read, write: if isManager();
    }

    match /payroll/{id} {
      allow read, write: if isManager();
    }

    match /budgets/{id} {
      allow read, write: if isManager();
    }

    // All authorized accounts need read-only company settings for PDFs and currency.
    match /settings/{id} {
      allow read: if hasAccess();
      allow write: if isOwner();
    }

    match /activityLogs/{id} {
      allow create: if hasAccess();
      allow read, delete: if isOwner();
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
