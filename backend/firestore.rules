rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    function email() {
      return request.auth.token.email;
    }

    function isOwner() {
      return signedIn() && email() == "jaeitte@gmail.com";
    }

    function accessPath() {
      return /databases/$(database)/documents/userAccess/$(email());
    }

    function accessData() {
      return get(accessPath()).data;
    }

    function hasAccess() {
      return signedIn()
        && (isOwner()
          || (exists(accessPath()) && accessData().active == true));
    }

    function storedRole() {
      return accessData().role;
    }

    function role() {
      return isOwner()
        ? "administrator"
        : (storedRole() == "manager" ? "manager" : "user");
    }

    function isManager() {
      return hasAccess() && (isOwner() || role() == "manager");
    }

    function isDelegatedManager() {
      return hasAccess() && !isOwner() && role() == "manager";
    }

    function usesCustomPermissions() {
      return hasAccess()
        && !isOwner()
        && ("customPermissions" in accessData())
        && accessData().customPermissions == true
        && ("permissions" in accessData());
    }

    function defaultUserPermission(permission) {
      return permission in [
        "quotes",
        "invoices",
        "customers",
        "products",
        "employees",
        "attendance",
        "payroll",
        "preferences"
      ];
    }

    function hasPermission(permission) {
      return isOwner()
        || (hasAccess()
          && (
            (usesCustomPermissions() && permission in accessData().permissions)
            || (!usesCustomPermissions() && role() == "manager")
            || (!usesCustomPermissions()
              && role() == "user"
              && defaultUserPermission(permission))
          ));
    }

    function payrollPeriodPath(month) {
      return /databases/$(database)/documents/payrollPeriods/$(month);
    }

    function payrollPeriodOpen(month) {
      return !exists(payrollPeriodPath(month))
        || get(payrollPeriodPath(month)).data.status == "OPEN";
    }

    function payrollAdministrativeChange() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status",
        "paymentDate",
        "paymentStatus",
        "paymentMethod",
        "paymentReference",
        "paymentNotes",
        "paidAt",
        "paidBy",
        "approvedAt",
        "approvedBy",
        "reopenedAt",
        "reopenedBy",
        "driveFileId",
        "driveWebViewLink",
        "driveUpdatedAt",
        "cancelledReason",
        "finalSettlementId",
        "updatedAt"
      ]);
    }

    match /userAccess/{emailId} {
      allow read: if isOwner() || (signedIn() && emailId == email());
      allow create, update, delete: if isOwner();
    }

    match /customers/{id} {
      allow read, write: if hasPermission("customers");
    }

    match /products/{id} {
      allow read, write: if hasPermission("products");
    }

    match /invoices/{id} {
      allow read, write: if hasPermission("invoices");
    }

    match /quotes/{id} {
      allow read, write: if hasPermission("quotes");
    }

    match /employees/{id} {
      allow read: if hasPermission("employees");
      allow create, update, delete: if isManager() && hasPermission("employees");
    }

    match /attendance/{id} {
      allow read: if hasPermission("attendance");
      allow create: if hasPermission("attendance")
        && request.resource.data.attendanceMonth is string
        && payrollPeriodOpen(request.resource.data.attendanceMonth);
      allow update: if hasPermission("attendance")
        && resource.data.attendanceMonth is string
        && request.resource.data.attendanceMonth == resource.data.attendanceMonth
        && payrollPeriodOpen(resource.data.attendanceMonth);
      allow delete: if isManager()
        && hasPermission("attendance")
        && resource.data.attendanceMonth is string
        && payrollPeriodOpen(resource.data.attendanceMonth);
    }

    match /payroll/{id} {
      allow read: if hasPermission("payroll");
      allow create: if isManager()
        && hasPermission("payroll")
        && (
          request.resource.data.recordType == "FINAL_SETTLEMENT"
          || (
            request.resource.data.salaryMonth is string
            && payrollPeriodOpen(request.resource.data.salaryMonth)
          )
        );
      allow update: if isManager()
        && hasPermission("payroll")
        && (
          (
            resource.data.salaryMonth is string
            && payrollPeriodOpen(resource.data.salaryMonth)
          )
          || payrollAdministrativeChange()
        );
      allow delete: if isManager()
        && hasPermission("payroll")
        && resource.data.salaryMonth is string
        && payrollPeriodOpen(resource.data.salaryMonth);
    }

    match /salarySlips/{id} {
      allow read: if hasPermission("payroll");
      allow create: if isManager() && hasPermission("payroll");
      allow update, delete: if isDelegatedManager()
        && hasPermission("payroll")
        && (!("locked" in resource.data) || resource.data.locked != true);
    }

    match /attendanceDocuments/{id} {
      allow read, create, update: if hasPermission("attendance");
      allow delete: if isManager() && hasPermission("attendance");
    }

    match /payrollPeriods/{month} {
      allow read: if hasPermission("payroll");
      allow create, update, delete: if isManager() && hasPermission("payroll");
    }

    match /finalSettlements/{id} {
      allow read: if hasPermission("payroll");
      allow create, update, delete: if isManager() && hasPermission("payroll");
    }

    match /payments/{id} {
      allow read, write: if hasPermission("payments");
    }

    match /expenses/{id} {
      allow read, write: if hasPermission("expenses");
    }

    match /billingContracts/{id} {
      allow read, write: if hasPermission("billing");

      match /generatedPeriods/{periodId} {
        allow read, write: if hasPermission("billing");
      }
    }

    match /budgets/{id} {
      allow read, write: if hasPermission("budget");
    }

    match /settings/attendance {
      allow read: if hasAccess();
      allow write: if isManager() && hasPermission("attendance-settings");
    }

    match /settings/{id} {
      allow read: if hasAccess();
      allow write: if isOwner();
    }

    match /companyAssets/{id} {
      allow read: if hasAccess();
      allow create, update, delete: if isOwner();
    }

    match /activityLogs/{id} {
      allow create: if hasAccess();
      allow read, delete: if isOwner();
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
