rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == "jaeitte@gmail.com";
    }

    function hasRequiredFields(required) {
      return request.resource.data.keys().hasAll(required);
    }

    match /customers/{id} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner()
        && hasRequiredFields(['name', 'createdAt', 'updatedAt']);
    }

    match /products/{id} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner()
        && hasRequiredFields(['name', 'quantity', 'price', 'threshold', 'createdAt', 'updatedAt'])
        && request.resource.data.quantity is number
        && request.resource.data.quantity >= 0
        && request.resource.data.price is number
        && request.resource.data.price >= 0;
    }

    match /invoices/{id} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner()
        && hasRequiredFields(['invoiceNumber', 'customerName', 'items', 'total', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.items is list
        && request.resource.data.total is number
        && request.resource.data.total >= 0;
    }

    match /quotes/{id} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner()
        && hasRequiredFields(['quoteNumber', 'customerName', 'items', 'total', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.items is list
        && request.resource.data.total is number
        && request.resource.data.total >= 0;
    }

    match /expenses/{id} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner()
        && hasRequiredFields(['description', 'amount', 'date', 'createdAt', 'updatedAt'])
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0;
    }


    match /billingContracts/{id} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner()
        && hasRequiredFields(['name', 'customerName', 'monthlyAmount', 'createdAt', 'updatedAt'])
        && request.resource.data.monthlyAmount is number
        && request.resource.data.monthlyAmount >= 0;

      match /generatedPeriods/{periodId} {
        allow read, write: if isOwner();
      }
    }



    match /employees/{id} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner()
        && hasRequiredFields(['employeeNumber', 'name', 'status', 'basicSalary', 'createdAt', 'updatedAt'])
        && request.resource.data.basicSalary is number
        && request.resource.data.basicSalary >= 0;
    }

    match /payroll/{id} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner()
        && hasRequiredFields(['employeeId', 'employeeName', 'salaryMonth', 'salarySlipNumber', 'grossSalary', 'totalDeductions', 'netSalary', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.grossSalary is number
        && request.resource.data.totalDeductions is number
        && request.resource.data.netSalary is number
        && request.resource.data.netSalary >= 0;
    }

    match /budgets/{id} {
      allow read, delete: if isOwner();
      allow create, update: if isOwner()
        && hasRequiredFields(['year', 'category', 'plannedAmount', 'actualAmount', 'createdAt', 'updatedAt'])
        && request.resource.data.plannedAmount is number
        && request.resource.data.plannedAmount >= 0
        && request.resource.data.actualAmount is number
        && request.resource.data.actualAmount >= 0;
    }

    match /settings/{id} {
      allow read, write: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
